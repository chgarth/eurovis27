---
import Layout from "../layouts/layout-main.astro";

import * as Welcome from "../components/welcome.mdx";
import * as Location from "../components/location.mdx";
import * as Partners from "../components/partners.mdx";
import * as Sponsors from "../components/sponsors.mdx";
---

<!-- CSS -------------------------------------------------------- -->
<style is:global>   

    h3 {
        font-size:          x-large;
        font-weight:        bold;  
        font-family:        var(--font-roboto-medium), system-ui, -apple-system, sans-serif; 
    }

/***** Additional options for Responsive Web Design *****/

@media screen and (max-width: 1080px) {

    h3 {
        font-size:          large;
    }

}

@media screen and (max-width: 720px) {

    h3 {
        font-size:          large;
    }
  
}
</style>


<!-- HTML ------------------------------------------------------- -->
<Layout 
    frontmatter={{ 
        title: "", 
        parent: "", 
        description: "This is the homepage for the 29th International Eurographics Conference on Visualization, which will be held for the first time in Stuttgart, Germany, in 2027." 
    }}
>

    <Welcome.Content />    
    <Location.Content />
    <hr>
    <Partners.Content />
    <Sponsors.Content />

</Layout>
